{"version":2,"kind":"Notebook","sha256":"93acb0f66ad33d9f3b7d7c7652739ee84230d4f584b46f7094ecd4c71e3577fa","slug":"figure-attenuation-coefficients","location":"/supporting_documents/theory/figure_attenuation_coefficients.ipynb","dependencies":[],"frontmatter":{"title":"Load attenuation coefficients","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"id":"Luuk Fröling","name":"Luuk Fröling"}],"date":"2024-01-01","github":"https://github.com/luukfroling/BEP","exports":[{"format":"ipynb","filename":"figure_attenuation_coefficients.ipynb","url":"/figure_attenuation_c-7547d6c06d2bcdc343b8117691ccebd2.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The attenuation coefficients change depending on the energy of the photons used. Load values and plot these.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Sw8FR7fIf4"}],"key":"GpYUj594Yl"}],"key":"t77b2vqEGg"},{"type":"block","kind":"notebook-code","data":{},"children":[{"type":"code","lang":"python","executable":true,"value":"import scipy.io\nimport matplotlib.pyplot as plt\n\n# Load the .mat file\nmat_data = scipy.io.loadmat('libs/materialAttenuationBoneWater.mat')\n\nfirst = mat_data['materialAttenuations'][:,0]\nsecond = mat_data['materialAttenuations'][:,1]\nplt.figure(figsize=(8, 6))\nplt.plot(first, label='Bone')\nplt.plot(second, label='Water')\nplt.xlabel('Energy (keV)')\n#nicely format the unit\nplt.ylabel(r\"Attenuation coefficient $\\mu$(cm$^{-1}$)\")\nplt.legend()\nplt.ylim(0,1)\nplt.show()","identifier":"materialattenuation-code","enumerator":"1","html_id":"materialattenuation-code","key":"pxu1xQklzY"},{"type":"output","id":"sn5vO0GWercnC-EzeLJai","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"cont