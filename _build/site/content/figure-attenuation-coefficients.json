{"version":2,"kind":"Notebook","sha256":"0d3594007f0ea5c4ef706ad2147a66cc3298ffe3db39a147c74678060a12f067","slug":"figure-attenuation-coefficients","location":"/supporting_documents/theory/figure_attenuation_coefficients.ipynb","dependencies":[],"frontmatter":{"title":"Attenuation coefficients water and bone","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"id":"Luuk Fröling","name":"Luuk Fröling"}],"date":"2024-01-01","github":"https://github.com/luukfroling/BEP","exports":[{"format":"ipynb","filename":"figure_attenuation_coefficients.ipynb","url":"/figure_attenuation_c-f4da738b7d1d1ae40c8b907b0990f547.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The attenuation coefficients change depending on the energy of the photons used.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cEceHG26ij"}],"key":"IH7wtx6tod"}],"key":"OoB14kVGGs"},{"type":"block","kind":"notebook-code","data":{},"children":[{"type":"code","lang":"python","executable":true,"value":"import scipy.io\nimport matplotlib.pyplot as plt\n\n# Load the .mat file\nmat_data = scipy.io.loadmat('libs/materialAttenuationBoneWater.mat')\n\nfirst = mat_data['materialAttenuations'][:,0]\nsecond = mat_data['materialAttenuations'][:,1]\nplt.figure(figsize=(8, 6))\nplt.plot(first, label='Bone')\nplt.plot(second, label='Water')\nplt.xlabel('Energy (keV)')\n#nicely format the unit\nplt.ylabel(r\"Attenuation coefficient $\\mu$(cm$^{-1}$)\")\nplt.legend()\nplt.ylim(0,1)\nplt.show()","identifier":"materialattenuation-code","enumerator":"1","html_id":"materialattenuation-code","key":"dYs7QlCXoI"},{"type":"output","id":"M1Nd13m7tfHTXwr8oEsKd","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"64ccdbd7840b97b269bc4a429597ebd6","path":"/64ccdbd7840b97b269bc4a429597ebd6.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}}],"identifier":"materialattenuation-output","html_id":"materialattenuation-output","key":"PZi55aRDN3"}],"identifier":"materialattenuation","label":"materialAttenuation","html_id":"materialattenuation","key":"evSnqbFUCu"}],"key":"f8EOu8ZRhe"},"references":{"cite":{"order":[],"data":{}}}}