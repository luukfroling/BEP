{"version":2,"kind":"Notebook","sha256":"03ea1e51efeb6c6a7b99d1b6354c77ad06be4d5178df04135934f9f47f5c123f","slug":"reconstruction","location":"/supporting_documents/method/reconstruction.ipynb","dependencies":[],"frontmatter":{"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"id":"Luuk Fröling","name":"Luuk Fröling"}],"date":"2024-01-01","github":"https://github.com/luukfroling/BEP","exports":[{"format":"ipynb","filename":"reconstruction.ipynb","url":"/reconstruction-1b204a67bf9b6d170292b02f897a7622.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","data":{},"children":[{"type":"code","lang":"python","executable":true,"value":"import pickle\nimport matplotlib.pyplot as plt\n\n#load iteration.pkl\nwith open('iteration.pkl', 'rb') as f:\n    x = pickle.load(f)\n\n# make 2x4 plot with all images in x\nplt.figure(figsize=(6, 3))\nfor i in range(8):\n    plt.subplot(2, 4, i + 1)\n    plt.imshow(x[i][0, :, 8:40, 16], cmap='gray')  # e.g., bone input\n    plt.title(f\"iteration {i+1}\")\n    plt.axis('off')\nplt.tight_layout()\nplt.show()","identifier":"iterations-code","enumerator":"1","html_id":"iterations-code","key":"XTwHr7Wk7v"},{"type":"output","id":"Az16IkT-0CuyhTdLw70Gu","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"47a8d42f599e527b323d72763db15f1e","path":"/47a8d42f599e527b323d72763db15f1e.png"},"text/plain":{"content":"<Figure size 600x300 with 8 Axes>","content_type":"text/plain"}}}],"identifier":"iterations-output","html_id":"iterations-output","key":"YyGQxsZ2fL"}],"identifier":"iterations","label":"iterations","html_id":"iterations","key":"D8x480WtzQ"}],"key":"KxEgLgxjwq"},"references":{"cite":{"order":[],"data":{}}}}